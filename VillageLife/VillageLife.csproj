<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VillageLife</AssemblyName>
    <RootNamespace>VillageLife</RootNamespace>
    <Version>3.15.0</Version>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Resolve the Valheim install directory (the folder containing valheim.exe).
    Priority: the VALHEIM_INSTALL environment variable, then the first common Steam
    path that exists on disk. If none match, set VALHEIM_INSTALL or hard-code the
    <ValheimDir> line below — see README.md. The CheckValheimDir target prints a
    clear error if the game assemblies still can't be found.
  -->
  <PropertyGroup Condition="'$(VALHEIM_INSTALL)' != ''">
    <ValheimDir>$(VALHEIM_INSTALL)</ValheimDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ValheimDir)' == ''">
    <ValheimDir Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim')">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' And Exists('C:\Program Files\Steam\steamapps\common\Valheim')">C:\Program Files\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' And Exists('D:\SteamLibrary\steamapps\common\Valheim')">D:\SteamLibrary\steamapps\common\Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' And Exists('D:\Steam\steamapps\common\Valheim')">D:\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' And Exists('E:\SteamLibrary\steamapps\common\Valheim')">E:\SteamLibrary\steamapps\common\Valheim</ValheimDir>
    <!-- Last-resort placeholder; the CheckValheimDir target will flag it if it doesn't exist. -->
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
  </PropertyGroup>
  <PropertyGroup>
    <BepInExDir>$(ValheimDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <!-- Fail early with an actionable message if Valheim's assemblies aren't where we looked. -->
  <Target Name="CheckValheimDir" BeforeTargets="ResolveAssemblyReferences;BeforeBuild">
    <Error Condition="!Exists('$(ValheimDir)\valheim_Data\Managed\assembly_valheim.dll')"
           Text="Valheim game assemblies not found. Looked in: $(ValheimDir)\valheim_Data\Managed. Set the VALHEIM_INSTALL environment variable to your Valheim folder (the one with valheim.exe), or edit the ValheimDir line in VillageLife.csproj. See README.md > Building." />
  </Target>

  <ItemGroup>
    <!-- BepInEx + Harmony + Jotunn (bundled in lib/ so build works without pre-installing mods) -->
    <Reference Include="BepInEx" HintPath="$(MSBuildThisFileDirectory)lib\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(MSBuildThisFileDirectory)lib\0Harmony.dll" Private="false" />
    <Reference Include="Jotunn" HintPath="$(MSBuildThisFileDirectory)lib\Jotunn.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Valheim assemblies -->
    <Reference Include="assembly_valheim" HintPath="$(ValheimDir)\valheim_Data\Managed\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimDir)\valheim_Data\Managed\assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ValheimDir)\valheim_Data\Managed\assembly_guiutils.dll" Private="false" />

    <!-- Unity -->
    <Reference Include="UnityEngine" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.AssetBundleModule.dll" Private="false" />
  </ItemGroup>

  <!-- Post-build: copy to BepInEx plugins folder -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(BepInExDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\VillageLife\" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(BepInExDir)\plugins\VillageLife\" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

  <!-- Optional: also copy the built DLL into an r2modman profile so launching "Start modded"
       picks up the fresh build with no manual copy. Inert unless the R2_PROFILE environment
       variable points at your profile folder, e.g. (run once, then reopen VS):
       setx R2_PROFILE "C:\Users\<you>\AppData\Roaming\r2modmanPlus-local\Valheim\profiles\<Profile>" -->
  <Target Name="CopyToR2Profile" AfterTargets="Build" Condition="'$(R2_PROFILE)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(R2_PROFILE)\BepInEx\plugins\VillageLife\" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(R2_PROFILE)\BepInEx\plugins\VillageLife\" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
