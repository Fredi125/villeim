<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VillageLife</AssemblyName>
    <RootNamespace>VillageLife</RootNamespace>
    <Version>3.0.0</Version>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Paths to Valheim and BepInEx - adjust per machine -->
    <ValheimDir Condition="'$(VALHEIM_INSTALL)' != ''">$(VALHEIM_INSTALL)</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == ''">G:\SteamLibrary\steamapps\common\Valheim</ValheimDir>
    <BepInExDir>$(ValheimDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx + Harmony + Jotunn (bundled in lib/ so build works without pre-installing mods) -->
    <Reference Include="BepInEx" HintPath="$(MSBuildThisFileDirectory)lib\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(MSBuildThisFileDirectory)lib\0Harmony.dll" Private="false" />
    <Reference Include="Jotunn" HintPath="$(MSBuildThisFileDirectory)lib\Jotunn.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Valheim assemblies -->
    <Reference Include="assembly_valheim" HintPath="$(ValheimDir)\valheim_Data\Managed\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimDir)\valheim_Data\Managed\assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ValheimDir)\valheim_Data\Managed\assembly_guiutils.dll" Private="false" />

    <!-- Unity -->
    <Reference Include="UnityEngine" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ValheimDir)\valheim_Data\Managed\UnityEngine.AssetBundleModule.dll" Private="false" />
  </ItemGroup>

  <!-- Post-build: copy to BepInEx plugins folder -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(BepInExDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\VillageLife\" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(BepInExDir)\plugins\VillageLife\" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
